{
  "expo": {
    "name": "LAZLANI",
    "slug": "lazlani",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lazlani",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0B24"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#0D0B24",
      "package": "com.lazlani.app",
      "versionCode": 18,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0D0B24"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fotoğraf yüklemek için galeri erişimine izin ver.",
          "cameraPermission": "Profil fotoğrafı çekmek için kamera erişimine izin ver."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://code-assistant-tool--saatcipora.replit.app",
      "googleAndroidClientId": "683496344356-fjl6sjds91u5st3fifh0ljagcpp0qdt6.apps.googleusercontent.com",
      "eas": {
        "projectId": "3d8af8f6-1c69-4724-8fd5-bf60b0341151"
      }
    },
    "owner": "yd6367000"
  }
}
